# =====================================================================
# AreaPro – D2D Sales · Umgebungsvariablen
# Lokal: Datei nach .env.local kopieren. Vercel: Project → Settings → Environment Variables.
# Ohne Supabase-Werte startet die App im Demo-Modus (Daten nur lokal im Browser).
# =====================================================================

# Öffentliche Adresse der App (für Calendly-Webhook & Kalender-Abo), z. B. https://areapro.vercel.app
APP_URL=

# --- Supabase (Pflicht für Produktivbetrieb) -------------------------
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUR serverseitig (Webhook, Kalender-Feed). Niemals im Frontend verwenden!
SUPABASE_SERVICE_ROLE_KEY=

# --- Calendly -------------------------------------------------------
# Calendly → Integrations → API & Webhooks → Personal Access Token
CALENDLY_PAT=
# optional: exakte URI des Ereignistyps (sonst Suche nach Name)
CALENDLY_EVENT_TYPE_URI=
CALENDLY_EVENT_TYPE_NAME=Beratungstermin HEIM & HAUS
# auto (Direktbuchung, Rückfall auf Einbettung) | api | embed | link
CALENDLY_BOOKING_MODE=auto
# beliebiger langer Zufallswert, z. B. `openssl rand -hex 32`
CALENDLY_WEBHOOK_SIGNING_KEY=
# Calendly verlangt eine E-Mail je Buchung. Ohne Kunden-E-Mail wird diese Adresse verwendet
# (z. B. eigene Adresse mit Plus-Zusatz: termine+kunde@ihre-domain.de)
CALENDLY_FALLBACK_INVITEE_EMAIL=
CALENDLY_TIMEZONE=Europe/Berlin

# --- Google Sheets (nur Export) --------------------------------------
# Google Cloud → Dienstkonto mit Google Sheets API; Tabelle mit der Dienstkonto-E-Mail teilen (Bearbeiter)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Privater Schlüssel aus der JSON-Datei, Zeilenumbrüche als \n
GOOGLE_PRIVATE_KEY=
# ID aus der Tabellen-URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
